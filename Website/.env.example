# Sanity project settings.
# Create a project with `npx sanity login` then `npx sanity init --env`,
# or copy the values from https://www.sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=hyl3j71t
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-28

# Optional: a viewer token enables draft previews and live content.
# Create one under Project -> API -> Tokens.
SANITY_API_READ_TOKEN=

# Jotform — receives the title company and contact form submissions.
# Create a key at https://www.jotform.com/myaccount/api (access: Full Access).
JOTFORM_API_KEY=
# Only for EU or HIPAA accounts, e.g. https://eu-api.jotform.com
# JOTFORM_API_BASE=https://api.jotform.com

# hCaptcha — the CAPTCHA on the site's forms. Keys from https://dashboard.hcaptcha.com
# (add your domain to the site). Leave both empty to disable the CAPTCHA.
# hCaptcha's test keys, for local development only:
#   NEXT_PUBLIC_HCAPTCHA_SITE_KEY=10000000-ffff-ffff-ffff-000000000001
#   HCAPTCHA_SECRET_KEY=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET_KEY=
